DB_TYPE=mysql
NODE_ENV=development
PORT=3200
DEMO_MODE=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USERNAME=root
DB_PASSWORD=change-this-password
DB_SYSTEM_DATABASE=sdm_system

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=change-this-password
REDIS_DB=0

# JWT
SYSTEM_SECRET=change-this-system-secret
SYSTEM_EXPIRES_IN=604800000
SYSTEM_REFRESH_SECRET=change-this-refresh-secret
SYSTEM_REFRESH_EXPIRES_IN=2592000000
SINGLE_DEVICE_LOGIN=false
REFRESH_DISABLE=false
CACHE_TOKEN_PREFIX=nestadmin
REFRESH_CACHE_TOKEN_PREFIX=nestadmin_refresh

# AES and signature
CRYPTO_AES_KEY=replace-with-32-char-key
CRYPTO_AES_IV=replace-with-16-char-iv
CRYPTO_SIGN_SECRET=change-this-sign-secret

