NODE_ENV=production
PORT=3000
DEMO_MODEL=false
DEMO_MODE=false

DB_TYPE=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_SYSTEM_DATABASE=nest_system

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_DB=0

SYSTEM_SECRET=change-this-system-secret
SYSTEM_EXPIRES_IN=604800000
SYSTEM_REFRESH_SECRET=change-this-refresh-secret
SYSTEM_REFRESH_EXPIRES_IN=2592000000
SINGLE_DEVICE_LOGIN=false
REFRESH_DISABLE=false
CACHE_TOKEN_PREFIX=nestman
REFRESH_CACHE_TOKEN_PREFIX=nestman_refresh

CRYPTO_AES_KEY=replace-with-32-char-key
CRYPTO_AES_IV=replace-with-16-char-iv
CRYPTO_SIGN_SECRET=change-this-sign-secret

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=
TENCENT_BUCKET=
STATIC_PATH=
